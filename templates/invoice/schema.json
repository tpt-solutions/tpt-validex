{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {"type": "string", "pattern": "^INV-[0-9]{4}-[0-9]{6}$"},
    "issue_date": {"type": "string", "format": "date"},
    "due_date": {"type": "string", "format": "date"},
    "supplier_vat": {"type": "string", "pattern": "^[A-Z]{2}[0-9A-Z]{8,12}$"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "net_amount": {"type": "number", "minimum": 0},
          "tax_rate": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["description", "net_amount", "tax_rate"]
      }
    },
    "total_amount": {"type": "number", "minimum": 0}
  },
  "required": ["invoice_number", "issue_date", "due_date", "supplier_vat", "lines", "total_amount"],
  "additionalProperties": false
}
